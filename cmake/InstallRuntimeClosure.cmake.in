# Resolve actual imports instead of copying every library from a vcpkg triplet.
set(_prefix "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}")
set(_root "@GEOREADER_VCPKG_RUNTIME_ROOT@")
set(_executable "${_prefix}/@CMAKE_INSTALL_BINDIR@/GeoReader@CMAKE_EXECUTABLE_SUFFIX@")
file(GLOB _plugins "${_prefix}/@GEOREADER_MAPNIK_PLUGIN_INSTALL_DIR@/*")
file(GET_RUNTIME_DEPENDENCIES
    EXECUTABLES "${_executable}"
    MODULES ${_plugins}
    DIRECTORIES "${_root}/bin" "${_root}/lib" "@GEOREADER_QT_RUNTIME_DIR@"
    RESOLVED_DEPENDENCIES_VAR _resolved
    UNRESOLVED_DEPENDENCIES_VAR _unresolved
    PRE_EXCLUDE_REGEXES "api-ms-.*" "ext-ms-.*"
    POST_EXCLUDE_REGEXES "[Ww][Ii][Nn][Dd][Oo][Ww][Ss]/[Ss][Yy][Ss][Tt][Ee][Mm]32/.*")
if(_unresolved)
    message(FATAL_ERROR "Unresolved runtime dependencies: ${_unresolved}")
endif()
if(WIN32)
    set(_destination "${_prefix}/@CMAKE_INSTALL_BINDIR@")
else()
    set(_destination "${_prefix}/@CMAKE_INSTALL_LIBDIR@/georeader")
endif()
set(_manifest "")
foreach(_library IN LISTS _resolved)
    # Qt deploy handles Qt and platform libraries. Only the resolved vcpkg
    # closure belongs here; system libraries stay supplied by the target OS.
    cmake_path(IS_PREFIX _root "${_library}" NORMALIZE _is_vcpkg)
    if(_is_vcpkg)
        file(INSTALL "${_library}" DESTINATION "${_destination}" TYPE SHARED_LIBRARY FOLLOW_SYMLINK_CHAIN)
        get_filename_component(_name "${_library}" NAME)
        string(APPEND _manifest "${_name}\n")
    endif()
endforeach()
file(MAKE_DIRECTORY "${_prefix}/@CMAKE_INSTALL_DATADIR@/georeader")
file(WRITE "${_prefix}/@CMAKE_INSTALL_DATADIR@/georeader/runtime-libraries.txt" "${_manifest}")
