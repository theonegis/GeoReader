# Resolve actual imports instead of copying every library from a vcpkg triplet.
if(POLICY CMP0207)
    cmake_policy(SET CMP0207 NEW)
endif()
set(_prefix "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}")
set(_root "@GEOREADER_VCPKG_RUNTIME_ROOT@")
set(_executable "${_prefix}/@CMAKE_INSTALL_BINDIR@/GeoReader@CMAKE_EXECUTABLE_SUFFIX@")
file(GLOB _plugins "${_prefix}/@GEOREADER_MAPNIK_PLUGIN_INSTALL_DIR@/*")
# Mapnik input plugins link to the Mapnik core library.  Treat that library as
# an explicit dependency root as well as a resolved dependency: CMake does not
# include root libraries in RESOLVED_DEPENDENCIES_VAR, and some ELF scanners do
# not reliably walk a MODULE's transitive closure when its install RPATH has
# already been rewritten.
if(WIN32)
    # vcpkg names the Windows core library libmapnik.dll.
    file(GLOB _mapnik_runtime_roots "${_root}/bin/*mapnik*.dll")
else()
    file(GLOB _mapnik_runtime_roots "${_root}/lib/libmapnik.so*")
endif()
if(NOT _mapnik_runtime_roots)
    message(FATAL_ERROR "Mapnik runtime library not found below ${_root}")
endif()
file(GET_RUNTIME_DEPENDENCIES
    EXECUTABLES "${_executable}"
    LIBRARIES ${_mapnik_runtime_roots}
    MODULES ${_plugins}
    DIRECTORIES "${_root}/bin" "${_root}/lib" "@GEOREADER_QT_RUNTIME_DIR@"
    RESOLVED_DEPENDENCIES_VAR _resolved
    UNRESOLVED_DEPENDENCIES_VAR _unresolved
    PRE_EXCLUDE_REGEXES "api-ms-.*" "ext-ms-.*"
    # Older CMake versions can return Windows paths with either separator.
    POST_EXCLUDE_REGEXES [[[Ww][Ii][Nn][Dd][Oo][Ww][Ss][/\\][Ss][Yy][Ss][Tt][Ee][Mm]32[/\\].*]])
if(_unresolved)
    message(FATAL_ERROR "Unresolved runtime dependencies: ${_unresolved}")
endif()
if(WIN32)
    set(_destination "${_prefix}/@CMAKE_INSTALL_BINDIR@")
else()
    set(_destination "${_prefix}/@CMAKE_INSTALL_LIBDIR@/georeader")
endif()
set(_manifest "")
set(_runtime_libraries ${_mapnik_runtime_roots} ${_resolved})
list(REMOVE_DUPLICATES _runtime_libraries)
cmake_path(NORMAL_PATH _root OUTPUT_VARIABLE _root_normalized)
foreach(_library IN LISTS _runtime_libraries)
    # Qt deploy handles Qt and platform libraries. Only the resolved vcpkg
    # closure belongs here; system libraries stay supplied by the target OS.
    # GET_RUNTIME_DEPENDENCIES may return a symlink spelling that resolves
    # differently from REAL_PATH during CPack staging. Compare the normalized
    # lexical paths so vcpkg libraries are not accidentally filtered out.
    set(_library_normalized "${_library}")
    cmake_path(NORMAL_PATH _library_normalized)
    string(FIND "${_library_normalized}" "${_root_normalized}/" _root_position)
    if(_root_position EQUAL 0)
        file(INSTALL "${_library}" DESTINATION "${_destination}" TYPE SHARED_LIBRARY FOLLOW_SYMLINK_CHAIN)
        get_filename_component(_name "${_library}" NAME)
        string(APPEND _manifest "${_name}\n")
    endif()
endforeach()
file(MAKE_DIRECTORY "${_prefix}/@CMAKE_INSTALL_DATADIR@/georeader")
file(WRITE "${_prefix}/@CMAKE_INSTALL_DATADIR@/georeader/runtime-libraries.txt" "${_manifest}")
